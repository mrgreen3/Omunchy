#!/usr/bin/env bash
# omunchy:summary=Omunchy menu (Super+Alt+Space): apps, install, remove, update, setup, system
#   omunchy-menu [section]   open straight at a section (e.g. omunchy-menu install, install-ai)
# Esc in a section goes back; Esc at the top closes.
bin=$(dirname "$(readlink -f "$0")")
live=0; [[ -d /run/archiso ]] && live=1

pick() { # pick <prompt> <options...>  -> chosen text
    local p=$1; shift
    printf '%s\n' "$@" | rofi -dmenu -i -p "$p" -no-show-icons \
        -theme-str 'listview { lines: 10; }'
}
ask() { rofi -dmenu -p "$1" -theme-str 'listview { lines: 0; }' </dev/null; }
run() { setsid -f "$@" >/dev/null 2>&1; }
term() { # term <title> <cmd...>  run in foot, wait for a key so the output can be read
    local t=$1; shift
    run foot -T "$t" bash -c '"$@"; echo; read -rsn1 -p "Finished. Press any key to close."' _ "$@"
}

ai_pick() { # ai_pick <verb> <agent rows> <command>
    local rows=$2 i
    [[ -n $rows ]] || { rofi -e "No AI agents to $1."; return; }
    i=$(cut -f2 <<<"$rows" | rofi -dmenu -i -p "$1 AI agent" -format i -no-show-icons) || return
    [[ -n $i ]] || return
    term "$1 AI agent" "$bin/$3" "$(sed -n "$((i + 1))p" <<<"$rows" | cut -f1)"
}

s_main() {
    local opts=("Apps")
    ((live)) && opts+=("Install Omunchy") || opts+=("Install" "Remove" "Update")
    opts+=("Setup" "System")
    case $(pick Omunchy "${opts[@]}") in
        Apps) s_apps ;;
        "Install Omunchy") run obinstall ;;
        Install) s_install ;;
        Remove) s_remove ;;
        Update) s_update ;;
        Setup) s_setup ;;
        System) s_system ;;
    esac
}

s_apps() {
    case $(pick Apps "Radio") in
        Radio) run foot -T Radio "$bin/omunchy-radio" ;;
        "") s_main ;;
    esac
}

s_install() {
    case $(pick Install "AI agent" "GPU drivers" "Snapper snapshots" "yay (AUR helper)" "Web app" "Web app presets") in
        "AI agent") ai_pick Install "$("$bin/omunchy-agents" available)" omunchy-install-ai ;;
        "GPU drivers") term "GPU drivers" "$bin/omunchy-install-gpu" ;;
        "Snapper snapshots") term Snapper "$bin/omunchy-install-snapper" ;;
        "yay (AUR helper)") term yay "$bin/omunchy-install-yay" ;;
        "Web app")
            local name url
            name=$(ask "Web app name") || return
            [[ -n $name ]] || return
            url=$(ask "URL for $name") || return
            [[ -n $url ]] || return
            term "Web app" "$bin/omunchy-webapp" add "$name" "$url"
            ;;
        "Web app presets") term "Web apps" "$bin/omunchy-webapp" presets ;;
        "") s_main ;;
    esac
}

s_remove() {
    case $(pick Remove "AI agent" "Web app") in
        "AI agent") ai_pick Remove "$("$bin/omunchy-agents" installed)" omunchy-remove-ai ;;
        "Web app")
            local apps app
            mapfile -t apps < <("$bin/omunchy-webapp" list 2>/dev/null)
            ((${#apps[@]})) || { rofi -e "No web apps installed."; return; }
            app=$(pick "Remove web app" "${apps[@]}") || return
            [[ -n $app ]] && term "Web app" "$bin/omunchy-webapp" remove "${app%%[[:space:]]*}"
            ;;
        "") s_main ;;
    esac
}

s_update() {
    case $(pick Update "Omunchy" "System packages" "Pacman keyring") in
        Omunchy) term "Omunchy update" "$bin/omunchy-update" ;;
        "System packages") run foot -T "System update" "$bin/omunchy-update-system" ;;
        "Pacman keyring") term Keyring "$bin/omunchy-fix-keys" ;;
        "") s_main ;;
    esac
}

s_setup() {
    case $(pick Setup "Keybindings" "Wallpaper" "Control centre") in
        Keybindings) run "$bin/omunchy-menu-keybinds" ;;
        Wallpaper) noctalia msg panel-toggle wallpaper ;;
        "Control centre") noctalia msg panel-toggle control-center ;;
        "") s_main ;;
    esac
}

s_system() {
    case $(pick System "Lock" "Power menu") in
        Lock) noctalia msg session lock ;;
        "Power menu") noctalia msg panel-toggle session ;;
        "") s_main ;;
    esac
}

pkill -x rofi && exit 0
case ${1:-} in
    "") s_main ;;
    install-ai) ((live)) && { rofi -e "AI agents are available after installing Omunchy."; exit 1; }
        ai_pick Install "$("$bin/omunchy-agents" available)" omunchy-install-ai ;;
    install | remove | update) ((live)) && { rofi -e "Install Omunchy first."; exit 1; }; "s_$1" ;;
    apps | setup | system) "s_$1" ;;
    -h | --help) sed -n '2,4s/^# \{0,1\}//p' "$0" ;;
    *) echo "unknown section: $1" >&2; exit 2 ;;
esac
