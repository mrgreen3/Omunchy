#!/bin/bash

# omunchy:summary=Reload the Hyprland session config (hyprctl reload)
# omunchy:args=
# omunchy:examples=omunchy hypr reload

set -euo pipefail

if ! command -v hyprctl >/dev/null 2>&1; then
    echo "omunchy-hypr-reload: hyprctl not found (is Hyprland running?)" >&2
    exit 1
fi

# HYPRLAND_INSTANCE_SIGNATURE picks the right session when several are logged in.
exec hyprctl reload