#!/bin/bash

# omunchy:summary=Toggle bar indicator states (DnD; `night` for night light)
# omunchy:args=[toggle-night]
# omunchy:examples=omunchy indicators-toggle toggle

# Thin wrapper so the waybar custom module can toggle through the omunchy
