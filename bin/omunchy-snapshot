#!/usr/bin/env bash
# omunchy:summary=System snapshots: list, create, restore (rollback that works with GRUB), clean
#   omunchy-snapshot list
#   omunchy-snapshot create [description]
#   omunchy-snapshot restore <number>   make snapshot <number> the system on next boot
#   omunchy-snapshot clean              delete roots set aside by earlier restores
# Restore keeps /home, logs and the package cache (their own subvolumes) and
# re-syncs the kernel and initramfs in /boot (FAT, not snapshotted) to the
# restored system. The replaced root is kept as @.old-<date> until clean.
set -euo pipefail

if ((EUID != 0)) && [[ ${1:-} == restore || ${1:-} == clean ]]; then
    SUDO=(sudo); [[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && SUDO=(sudo -A)
    exec "${SUDO[@]}" "$0" "$@"
fi
[[ ! -d /run/archiso ]] || { echo "Running live - install Omunchy first."; exit 1; }

die() { echo "omunchy-snapshot: $*" >&2; exit 1; }
need_snapper() { snapper -c root get-config >/dev/null 2>&1 || die "snapshots are not set up: run omunchy-install-snapper"; }

top= new=
cleanup() {
    [[ -n $new ]] && { umount -R "$new" 2>/dev/null || true; rmdir "$new" 2>/dev/null || true; }
    [[ -n $top ]] && { umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true; }
}
trap cleanup EXIT

mount_top() { # the btrfs top level (subvolid 5) of the root filesystem
    local dev; dev=$(findmnt -no SOURCE / | sed 's/\[.*//')
    [[ $(findmnt -no FSTYPE /) == btrfs ]] || die "/ is not btrfs"
    top=$(mktemp -d /run/omunchy-snapshot.XXXXXX)
    mount -o subvolid=5 "$dev" "$top"
    [[ -d $top/@ && -d $top/@snapshots ]] || die "unexpected btrfs layout (need @ and @snapshots at the top level)"
}

restore() {
    local n=${1:-} ans stamp kver pkgbase
    [[ $n =~ ^[0-9]+$ ]] || die "usage: omunchy-snapshot restore <number> (see: omunchy-snapshot list)"
    need_snapper
    mount_top
    local snap=$top/@snapshots/$n/snapshot
    [[ -d $snap ]] || die "no snapshot $n"
    [[ -d $snap/usr/lib/modules ]] || die "snapshot $n has no /usr/lib/modules: not a root snapshot"
    findmnt -no OPTIONS / | grep -q 'subvol=/@\(,\|$\)' || die "/ is not the @ subvolume (booted into a snapshot?): boot the normal entry first"

    echo "Snapshot $n: $(snapper -c root --csvout list --columns number,date,description | awk -F, -v n="$n" '$1 == n { print $2" "$3 }')"
    echo "On next boot the system (not /home) goes back to this point."
    if [[ -t 0 ]]; then read -rp "Restore it? [y/N] " ans; [[ $ans == [yY]* ]] || { echo "Cancelled."; exit 0; }; fi

    stamp=$(date +%Y%m%d-%H%M%S)
    # the running system keeps working from the renamed subvolume until reboot
    mv "$top/@" "$top/@.old-$stamp"
    if ! btrfs subvolume snapshot "$snap" "$top/@" >/dev/null; then
        mv "$top/@.old-$stamp" "$top/@"; die "could not create the new root; nothing changed"
    fi

    # /boot is not in the snapshot: put the restored system's kernels and initramfs there
    new=$(mktemp -d /run/omunchy-snapshot-new.XXXXXX)
    mount -o subvol=@ "$(findmnt -no SOURCE / | sed 's/\[.*//')" "$new"
    mount --bind /boot "$new/boot"
    for kver in "$new"/usr/lib/modules/*/; do
        [[ -f $kver/pkgbase && -f $kver/vmlinuz ]] || continue
        pkgbase=$(<"$kver/pkgbase")
        install -Dm644 "$kver/vmlinuz" "/boot/vmlinuz-$pkgbase"
        echo "  kernel: $pkgbase $(basename "$kver")"
    done
    if ! arch-chroot "$new" mkinitcpio -P >/dev/null 2>&1; then
        echo "omunchy-snapshot: initramfs rebuild failed; undoing." >&2
        umount -R "$new"; rmdir "$new"; new=
        btrfs subvolume delete "$top/@" >/dev/null
        mv "$top/@.old-$stamp" "$top/@"
        # put the current system's kernel back
        for kver in /usr/lib/modules/*/; do
            [[ -f $kver/pkgbase && -f $kver/vmlinuz ]] && install -Dm644 "$kver/vmlinuz" "/boot/vmlinuz-$(<"$kver/pkgbase")"
        done
        mkinitcpio -P >/dev/null 2>&1 || echo "WARNING: also failed to rebuild the current initramfs: do not reboot, run mkinitcpio -P" >&2
        exit 1
    fi
    echo "  initramfs rebuilt"
    if [[ -f /boot/grub/grub.cfg ]]; then
        mount --bind /.snapshots "$new/.snapshots" 2>/dev/null || true
        arch-chroot "$new" grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 &&
            echo "  boot menu regenerated" || echo "  warning: grub-mkconfig failed; the old menu still boots the restored system"
    fi
    snapper -c root create -d "omunchy-snapshot: restored $n (old root @.old-$stamp)" --cleanup-algorithm number 2>/dev/null || true
    echo "Done. Reboot to start the restored system."
    echo "The replaced system is kept as @.old-$stamp; free the space later with: omunchy-snapshot clean"
}

clean() {
    mount_top
    local olds=("$top"/@.old-*) o ans
    [[ -e ${olds[0]} ]] || { echo "Nothing to clean."; return; }
    for o in "${olds[@]}"; do
        # never the subvolume the system is running from (before the post-restore reboot)
        if [[ $(btrfs subvolume show "$o" | awk '/Subvolume ID/ { print $3 }') == "$(btrfs subvolume show / | awk '/Subvolume ID/ { print $3 }')" ]]; then
            echo "  ${o##*/} is the running system: reboot first"; continue
        fi
        if [[ -t 0 ]]; then read -rp "Delete ${o##*/}? [y/N] " ans; [[ $ans == [yY]* ]] || continue; fi
        btrfs subvolume delete "$o" >/dev/null && echo "  deleted ${o##*/}"
    done
}

case ${1:-} in
    list) need_snapper; snapper -c root list ;;
    create) need_snapper; shift; snapper -c root create -d "${*:-manual}" --cleanup-algorithm number --print-number | sed 's/^/Created snapshot /' ;;
    restore) restore "${2:-}" ;;
    clean) clean ;;
    *) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
