#!/usr/bin/env bash
# omunchy:summary=Print the AI agents table (shipped rows, then ~/.config/omunchy/agents.tsv)
#   omunchy-agents            id<TAB>label<TAB>mise tool<TAB>command<TAB>args
#   omunchy-agents installed  only rows whose command is installed via mise
#   omunchy-agents get <id>   one row
dir=$(dirname "$(readlink -f "$0")")/..
shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
rows() { cat "$dir/default/agents.tsv" "${XDG_CONFIG_HOME:-$HOME/.config}/omunchy/agents.tsv" 2>/dev/null | awk -F'\t' '!/^#/ && NF >= 4 && !seen[$1]++'; }
case ${1:-} in
    "") rows ;;
    installed) rows | while IFS=$'\t' read -r id label tool cmd args; do
            [[ -x $shims/$cmd ]] && printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$label" "$tool" "$cmd" "$args"
        done ;;
    get) rows | awk -F'\t' -v id="$2" '$1 == id { print; f = 1 } END { exit !f }' ;;
    *) sed -n '2,5s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
