#!/bin/bash

# omunchy:summary=Set the desktop wallpaper image (rewrites the hyprpaper line)
# omunchy:args=<image-path>
# omunchy:examples=omunchy bg set ~/Backgrounds/kanagawa.jpg

set -euo pipefail

usage() {
    printf 'Usage: omunchy bg set <image-path>\n'
    printf 'Rewrites the hyprpaper exec line in ~/.config/hypr/looknfeel.lua\n'
    printf 'and applies it to the running session via hyprctl.\n'
}

if [[ ${1:-} == -h || ${1:-} == --help || $# -ne 1 ]]; then
    usage
    [[ ${1:-} == -h || ${1:-} == --help ]] && exit 0
    exit 1
fi

IMG=$1
[[ -f $IMG ]] || {
    echo "Not a file: $IMG" >&2
    exit 1
}
IMG=$(readlink -f -- "$IMG")

HYPR_CONF="$HOME/.config/hypr/looknfeel.lua"
[[ -f $HYPR_CONF ]] || {
    echo "No $HYPR_CONF — install the Omunchy configs first." >&2
    exit 1
}

# Copy into ~/Backgrounds so the wallpaper survives the source file moving
# (matches how the ISO ships Backgrounds/).
BG_DIR="$HOME/Backgrounds"
mkdir -p "$BG_DIR"
cp -n "$IMG" "$BG_DIR/" 2>/dev/null || true
INSTALLED="$BG_DIR/$(basename -- "$IMG")"
[[ -f $INSTALLED ]] || INSTALLED=$IMG

# Replace ONLY the WALLPAPER_MARKER exec line (hyprpaper 0.8 has no
# preload/unload — one wallpaper call is the whole IPC; the sleep guards
# hyprpaper's own start).
sed -i \
    -e "s|^.*hl.exec_cmd.*WALLPAPER_MARKER.*|    hl.exec_cmd(\"sleep 1 \\&\\& hyprctl hyprpaper wallpaper '$INSTALLED'\") -- WALLPAPER_MARKER|" \
    "$HYPR_CONF"

# Apply to the running session right away (all-monitors form; hyprpaper 0.8
# takes the whole call as one request).
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl hyprpaper wallpaper ",$INSTALLED" &>/dev/null || true
fi

echo "Wallpaper set: $INSTALLED"