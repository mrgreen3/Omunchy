#!/usr/bin/env bash
# Interactive pacman update for the waybar updates badge (on-click).
# Shows what's pending, runs the update, refreshes the badge, keeps the
# terminal open so the result can be read.

pause() { [[ -n ${OMUNCHY_NO_PAUSE:-} ]] || read -rp "Press Enter to close..."; }

if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg ]]; then
    echo "Pacman keyring not set up - run omunchy-fix-keys first."
    pause
    exit 1
fi

# pacman needs room to download and unpack; a full disk mid-upgrade is hard to recover
avail=$(df --output=avail -k / | tail -1)
if ((avail < 2 * 1024 * 1024)); then
    echo "Only $((avail / 1024)) MiB free on /: free at least 2 GiB before updating"
    echo "(pacman -Sc clears old cached packages; omunchy-snapshot clean frees old roots)."
    pause
    exit 1
fi

echo "Checking for updates..."
pending=$(checkupdates 2>/dev/null)
if [[ -z $pending ]]; then
    echo "System is up to date."
    pause
    exit 0
fi

echo
echo "$pending"
echo
echo "$(wc -l <<<"$pending") updates pending. Running: sudo pacman -Syu"
echo

SUDO=(sudo); [[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && SUDO=(sudo -A)
# keyring first, same transaction run: avoids signature errors from new packager keys
"${SUDO[@]}" pacman -Sy --needed --noconfirm archlinux-keyring && "${SUDO[@]}" pacman -Su
rc=$?
echo
if ((rc == 0)); then
    echo "Update complete."
    snapper -c root get-config >/dev/null 2>&1 && echo "Snapshots before/after were taken (omunchy-snapshot list)."
    orphans=$(pacman -Qdtq 2>/dev/null | wc -l)
    ((orphans)) && echo "$orphans packages are no longer needed by anything (see: pacman -Qdt)."
    if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
        echo "The kernel was updated: reboot soon (new drivers and modules load only after a reboot)."
        notify-send -a Omunchy "Reboot recommended" "The kernel was updated" 2>/dev/null || true
    fi
else
    echo "Update failed (exit $rc). Scroll up for pacman's output."
fi

pkill -RTMIN+8 waybar 2>/dev/null
pause
