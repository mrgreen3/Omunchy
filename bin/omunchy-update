#!/usr/bin/env bash
# omunchy:summary=Update Omunchy: pull its files, run migrations, then update packages
#   omunchy-update             all three steps
#   omunchy-update --no-packages   skip the pacman step
# ~/.local/share/omunchy is a git checkout of github.com/mrgreen3/Omunchy (bin/
# is on PATH). Local edits there block the update: keep your own scripts in ~/Scripts.

set -uo pipefail

SRC=${XDG_DATA_HOME:-$HOME/.local/share}/omunchy
BRANCH=${OMUNCHY_BRANCH:-main}
REPO=${OMUNCHY_REPO:-https://github.com/mrgreen3/Omunchy.git}

packages=1 stage=pull
for a in "$@"; do
    case $a in
        --no-packages) packages=0 ;;
        --after-pull) stage=after ;;
        -h | --help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done
args=(); ((packages)) || args+=(--no-packages)

if [[ -d /run/archiso ]]; then
    echo "Running live - install Omunchy first."
    exit 1
fi

if [[ $stage == pull ]]; then
    "$(dirname "$(readlink -f "$0")")/omunchy-netcheck" || { echo "Connect first and retry."; exit 1; }

    if [[ ! -d $SRC/.git ]]; then
        echo "Fetching Omunchy..."
        git clone --quiet --depth 1 --branch "$BRANCH" "$REPO" "$SRC" || { echo "git clone failed."; exit 1; }
    else
        if [[ -n $(git -C "$SRC" status --porcelain --untracked-files=no) ]]; then
            echo "Local changes in $SRC block the update:"
            git -C "$SRC" status --short --untracked-files=no
            echo "Move your own versions to ~/Scripts, then: git -C $SRC checkout -- ."
            exit 1
        fi
        before=$(git -C "$SRC" rev-parse --short HEAD)
        echo "Updating Omunchy..."
        git -C "$SRC" remote set-url origin "$REPO"
        git -C "$SRC" fetch --quiet --depth 1 origin "+$BRANCH:refs/remotes/origin/$BRANCH" ||
            { echo "git fetch of $BRANCH failed."; exit 1; }
        # Shallow checkout: move straight to the new tip (no merge history to walk).
        git -C "$SRC" checkout --quiet -B "$BRANCH" "origin/$BRANCH" || { echo "Checkout failed."; exit 1; }
        after=$(git -C "$SRC" rev-parse --short HEAD)
        if [[ $before == "$after" ]]; then
            echo "Omunchy already up to date ($after)."
        else
            echo "Omunchy $before -> $(git -C "$SRC" log -1 --format='%h %s')"
        fi
    fi
    # Continue in the freshly pulled copy of this script.
    exec "$SRC/bin/omunchy-update" --after-pull "${args[@]}"
fi

# Wallpapers are additive: add new ones, never overwrite or remove.
mkdir -p "$HOME/Backgrounds"
for f in "$SRC"/airootfs/etc/skel/Backgrounds/*; do
    [[ -f $f && ${f,,} =~ \.(jpe?g|png|webp)$ ]] || continue
    dest=$HOME/Backgrounds/${f##*/}
    [[ -e $dest ]] && continue
    cp -p "$f" "$dest" && echo "  new wallpaper ~/Backgrounds/${f##*/}"
done

"$SRC/bin/omunchy-migrate" || exit 1

((packages)) || exit 0
echo
OMUNCHY_NO_PAUSE=1 "$SRC/bin/omunchy-update-system"
