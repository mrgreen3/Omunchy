#!/usr/bin/env bash
# omunchy:summary=Switch the desktop theme (noctalia palette; mango, waybar, rofi, foot follow)
#   omunchy-theme list | current | set <name> | pick
# Themes: default/themes.tsv, then ~/.config/omunchy/themes.tsv (same format).
set -euo pipefail
dir=$(dirname "$(readlink -f "$0")")/..
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
state=$cfg/omunchy/theme

rows() {
    local f
    for f in "$dir/default/themes.tsv" "$cfg/omunchy/themes.tsv"; do if [[ -f $f ]]; then cat "$f"; fi; done |
        awk -F'\t' '!/^#/ && NF >= 4 && !seen[$1]++'
}

set_theme() {
    local row name src scheme mode
    row=$(rows | awk -F'\t' -v n="$1" 'tolower($1) == tolower(n) && !f { print; f = 1 }')
    [[ -n $row ]] || { echo "omunchy-theme: no theme '$1' (see: omunchy-theme list)" >&2; exit 1; }
    IFS=$'\t' read -r name src scheme mode <<<"$row"
    if [[ $src == custom ]]; then
        [[ $scheme != */* ]] || { echo "omunchy-theme: bad palette name '$scheme'" >&2; exit 1; }
        if [[ -f $dir/default/palettes/$scheme.json ]]; then
            mkdir -p "$cfg/noctalia/palettes"
            cp -f "$dir/default/palettes/$scheme.json" "$cfg/noctalia/palettes/$scheme.json"
        fi
        [[ -f $cfg/noctalia/palettes/$scheme.json ]] ||
            { echo "omunchy-theme: palette $cfg/noctalia/palettes/$scheme.json not found" >&2; exit 1; }
    fi
    noctalia msg theme-mode-set "$mode" >/dev/null
    noctalia msg color-scheme-set "$src" "$scheme" >/dev/null
    mkdir -p "${state%/*}"; printf '%s\n' "$name" >"$state"
    echo "Theme: $name"
}

case ${1:-} in
    list) rows | cut -f1 ;;
    current) cat "$state" 2>/dev/null || echo Wallpaper ;;
    set) [[ -n ${2:-} ]] || { echo "usage: omunchy-theme set <name>" >&2; exit 2; }; set_theme "$2" ;;
    pick)
        cur=$("$0" current)
        t=$(rows | cut -f1 | rofi -dmenu -i -p "Theme ($cur)" -no-show-icons) || exit 0
        [[ -z $t ]] || set_theme "$t" >/dev/null
        ;;
    *) sed -n '2,4s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
