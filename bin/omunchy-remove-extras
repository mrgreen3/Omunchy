#!/usr/bin/env bash
# omunchy:summary=Remove an extras package (see omunchy-extras)
#   omunchy-remove-extras <id>
set -uo pipefail
bin=$(dirname "$(readlink -f "$0")")
[[ $# -eq 1 ]] || { echo "usage: omunchy-remove-extras <id>"; "$bin/omunchy-extras" installed | cut -f1,2; exit 2; }
row=$("$bin/omunchy-extras" get "$1") || { echo "Unknown extras package: $1" >&2; exit 1; }
IFS=$'\t' read -r id label note <<<"$row"
pacman -Q "$id" >/dev/null 2>&1 || { echo "$label is not installed."; exit 0; }
SUDO=(sudo)
[[ ! -t 0 && -n ${SUDO_ASKPASS:-} ]] && SUDO=(sudo -A)

"${SUDO[@]}" pacman -R --noconfirm "$id"
