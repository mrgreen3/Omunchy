#!/bin/bash

# omunchy:summary=Generate a colour theme from a wallpaper (matugen) and apply it
# omunchy:args=<image-path>
# omunchy:examples=omunchy theme wallpaper ~/Backgrounds/mountain-moon.jpg

# Derives a dark palette from the image with matugen, writes it as
# ~/.config/omunchy/themes/wallpaper.conf (same NAME=hex format as
# config/themes/*.conf) and applies it with omunchy-theme-set. `omunchy bg set`
# calls this, so the desktop recolours whenever the wallpaper changes.

set -euo pipefail

usage() {
    printf 'Usage: omunchy theme wallpaper <image-path>\n'
    printf 'Generates ~/.config/omunchy/themes/wallpaper.conf from the image and applies it.\n'
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    usage
    exit 0
fi
[[ $# -eq 1 ]] || { usage >&2; exit 1; }

IMG=$1
[[ -f $IMG ]] || {
    echo "Not a file: $IMG" >&2
    exit 1
}
command -v matugen >/dev/null 2>&1 || {
    echo "matugen is not installed (pacman -S matugen)" >&2
    exit 1
}

SOURCE=${BASH_SOURCE[0]}
while [[ -L $SOURCE ]]; do
    DIR=$(cd -P "$(dirname -- "$SOURCE")" && pwd)
    SOURCE=$(readlink -- "$SOURCE")
    [[ $SOURCE == /* ]] || SOURCE="$DIR/$SOURCE"
done
BIN_DIR=$(cd -P "$(dirname -- "$SOURCE")" && pwd)

STATE_DIR="$HOME/.config/omunchy"
OUT="$STATE_DIR/themes/wallpaper.conf"
mkdir -p "$STATE_DIR/themes"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Render the matugen dark scheme straight into NAME=hex lines via a template,
# so no JSON parsing (and no jq/python) is needed.
cat >"$WORK/tpl" <<'EOF'
BG={{colors.background.dark.hex_stripped}}
SURFACE={{colors.surface_variant.dark.hex_stripped}}
FG={{colors.on_surface.dark.hex_stripped}}
FG_DIM={{colors.on_surface_variant.dark.hex_stripped}}
ACCENT={{colors.primary.dark.hex_stripped}}
ON_ACCENT={{colors.on_primary.dark.hex_stripped}}
RED={{colors.error.dark.hex_stripped}}
EOF
cat >"$WORK/cfg.toml" <<EOF
[config]
[templates.omunchy]
input_path = "$WORK/tpl"
output_path = "$WORK/palette"
EOF

matugen image "$IMG" -c "$WORK/cfg.toml" --mode dark --prefer saturation >/dev/null 2>"$WORK/err" || {
    echo "matugen failed:" >&2
    cat "$WORK/err" >&2
    exit 1
}

# Strict parse: only KNOWN_NAME=6-hex lines are accepted.
declare -A P
while IFS='=' read -r k v; do
    [[ $k =~ ^(BG|SURFACE|FG|FG_DIM|ACCENT|ON_ACCENT|RED)$ && $v =~ ^[0-9a-fA-F]{6}$ ]] && P[$k]=${v,,}
done <"$WORK/palette"
for k in BG SURFACE FG FG_DIM ACCENT ON_ACCENT RED; do
    [[ -n ${P[$k]:-} ]] || {
        echo "matugen produced no value for $k" >&2
        exit 1
    }
done

# Rotate the accent hue for the green/yellow roles (HLS, same as the palette
# maths in the archbang-theme skill).
rotate_hue() { # $1 hex6, $2 degrees
    awk -v hex="$1" -v deg="$2" '
    function hue2rgb(m1, m2, h) {
        h = h - int(h); if (h < 0) h += 1
        if (h < 1/6) return m1 + (m2 - m1) * h * 6
        if (h < 0.5) return m2
        if (h < 2/3) return m1 + (m2 - m1) * (2/3 - h) * 6
        return m1
    }
    BEGIN {
        r = strtonum("0x" substr(hex, 1, 2)) / 255
        g = strtonum("0x" substr(hex, 3, 2)) / 255
        b = strtonum("0x" substr(hex, 5, 2)) / 255
        mx = (r > g ? (r > b ? r : b) : (g > b ? g : b))
        mn = (r < g ? (r < b ? r : b) : (g < b ? g : b))
        l = (mx + mn) / 2
        if (mx == mn) { h = 0; s = 0 }
        else {
            d = mx - mn
            s = (l > 0.5) ? d / (2 - mx - mn) : d / (mx + mn)
            if (mx == r) h = (g - b) / d + (g < b ? 6 : 0)
            else if (mx == g) h = (b - r) / d + 2
            else h = (r - g) / d + 4
            h /= 6
        }
        h = h + deg / 360; h = h - int(h); if (h < 0) h += 1
        if (s == 0) { r = g = b = l }
        else {
            m2 = (l <= 0.5) ? l * (1 + s) : l + s - l * s
            m1 = 2 * l - m2
            r = hue2rgb(m1, m2, h + 1/3); g = hue2rgb(m1, m2, h); b = hue2rgb(m1, m2, h - 1/3)
        }
        printf "%02x%02x%02x\n", int(r * 255 + 0.5), int(g * 255 + 0.5), int(b * 255 + 0.5)
    }'
}
GREEN=$(rotate_hue "${P[ACCENT]}" 120)
YELLOW=$(rotate_hue "${P[ACCENT]}" 60)

cat >"$OUT" <<EOF
# Generated by omunchy-theme-wallpaper from $(basename -- "$IMG") — do not edit.
FOOT_BG=${P[BG]}
FOOT_FG=${P[FG]}
FOOT_ALPHA=0.9
WAYBAR_BG=${P[BG]}
WAYBAR_BG_ALPHA=0.9
WAYBAR_SURFACE=${P[SURFACE]}
WAYBAR_FG=${P[FG]}
WAYBAR_FG_DIM=${P[FG_DIM]}
WAYBAR_ACCENT=${P[ACCENT]}
WAYBAR_ON_ACCENT=${P[ON_ACCENT]}
WAYBAR_RED=${P[RED]}
WAYBAR_GREEN=$GREEN
WAYBAR_YELLOW=$YELLOW
MAKO_BG=${P[BG]}99
MAKO_TEXT=${P[FG]}
MAKO_BORDER=${P[ACCENT]}
ROFI_BG=${P[BG]}b3
ROFI_BG_ALT=${P[SURFACE]}c8
ROFI_FG=${P[FG]}ff
ROFI_FG_DIM=${P[FG_DIM]}ff
ROFI_ACCENT=${P[ACCENT]}ff
ROFI_URGENT=${P[RED]}ff
ROFI_SELECTED_FG=${P[ON_ACCENT]}ff
SWAY_ACTIVE_BORDER=${P[ACCENT]}ff
SWAY_INACTIVE_BORDER=${P[SURFACE]}aa
EOF

exec "$BIN_DIR/omunchy-theme-set" wallpaper
