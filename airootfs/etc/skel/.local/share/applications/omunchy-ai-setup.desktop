[Desktop Entry]
Version=1.0
Name=AI Setup Assistant
GenericName=Set up your system with OpenCode
Comment=Opens OpenCode with a menu of setup tasks (needs a network)
Exec=foot --app-id=omunchy.TUI.float -e opencode --standalone --prompt "Use the setup-menu skill to show me what you can set up."
Terminal=false
Type=Application
Icon=utilities-terminal
StartupNotify=true
Categories=Utility;
