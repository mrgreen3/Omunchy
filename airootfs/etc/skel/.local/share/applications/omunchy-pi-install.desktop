[Desktop Entry]
Version=1.0
Name=Pi
GenericName=Launch the pi coding agent
Comment=Launches pi; installs it first if missing
Exec=foot --app-id=omunchy.TUI.float -e sh -c "exec ~/Scripts/omunchy-pi-install"
Terminal=false
Type=Application
Icon=utilities-terminal
StartupNotify=true
Categories=Utility;