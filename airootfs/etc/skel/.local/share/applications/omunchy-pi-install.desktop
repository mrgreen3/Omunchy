[Desktop Entry]
Version=1.0
Name=Install Pi
GenericName=Install the pi coding agent
Comment=Checks the network and runs the official pi.dev installer
Exec=foot --app-id=omunchy.Installer -e sh -c "exec ~/Scripts/omunchy-pi-install"
Terminal=false
Type=Application
Icon=system-software-install
StartupNotify=true
Categories=Utility;