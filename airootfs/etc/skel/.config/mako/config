# Mako notification daemon configuration

anchor=top-right
margin=10
padding=8
border-size=2
border-radius=0
default-timeout=4000
font=JetBrains Mono 10.5
background-color=#0f151199
text-color=#dfe4dd
border-color=#93d5aa
max-visible=3

# DnD (bar indicator / `omunchy indicators toggle`): makoctl mode -t
# do-not-disturb flips this mode; invisible=1 hides the toasts.
[mode=do-not-disturb]
invisible=1
