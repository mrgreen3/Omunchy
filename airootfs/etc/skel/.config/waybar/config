{
  // Omunchy default bar — Omarchy quattro (shell.json) parity, waybar edition.
  // Widget-for-widget mapping of Omarchy's default bar layout, per
  // docs/bar-research.md §5. Module list mirrors shell.json's bar.layout
  // (menu, workspaces | indicators, clock, keyboard, update | tray, network,
  // audio, monitor, power) with the Omunchy substitutions: rofi for the
  // quickshell menu, mako DnD for the notifications service, scripts for the
  // indicator states. Omarchy's opt-in widgets (media/window) are
  // enabled here since waybar costs nothing for them; elsewhen and agents are
  // Omarchy/Omunchy-specific and omitted.
  //
  // Colour: all colours live in style.css as @define-color lines, rewritten
  // — no hex values in this file.
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 4,

  "modules-left": [
    "custom/menu",
    "ext/workspaces"
  ],
  "modules-center": [
    "custom/dnd",
    "clock",
    "custom/updates"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon",
    "mpris",
    "custom/power"
  ],

  // omarchy.menu — noctalia launcher (same as Super+Space)
  "custom/menu": {
    "format": "󰍜",
    "on-click": "noctalia msg panel-toggle launcher",
    "on-click-right": "foot",
    "tooltip": false
  },

  // omarchy.workspaces — one pill per tag (mango); click switches tag
  "ext/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-id": true,
    "all-outputs": true
  },

  // omarchy.indicators — DnD: dim until on, click toggles (night light and
  // stay awake are in the noctalia control centre); signal 7 (8 is custom/updates)
  "custom/dnd": {
    "format": "{}",
    "exec": "~/Scripts/indicators.sh state dnd",
    "return-type": "json",
    "interval": 5,
    "signal": 7,
    "on-click": "~/Scripts/indicators.sh toggle-dnd"
  },

  // omarchy.clock — "dddd HH:mm" in Omarchy; click opens the noctalia calendar
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "on-click": "noctalia msg panel-toggle control-center calendar",
    "tooltip": false,
    "interval": 60
  },

  // omarchy.system-update — badge only when updates are pending; 6 h poll
  "custom/updates": {
    "format": "{}",
    "exec": "~/Scripts/updates.sh",
    "return-type": "json",
    "interval": 21600,
    "on-click": "foot -e ~/Scripts/system-update",
    "signal": 8
  },

  // omarchy.tray
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": false
  },

  // omarchy.bluetooth — noctalia control-centre bluetooth tab
  "bluetooth": {
    "format": "{icon}",
    "format-disabled": "",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲",
      "connected": "󰂱"
    },
    "on-click": "noctalia msg panel-toggle control-center bluetooth",
    "tooltip-format": "Bluetooth: {status}"
  },

  // omarchy.network — noctalia control-centre network tab
  "network": {
    "format": "{icon}",
    "format-icons": {
      "wifi": "󰤨",
      "ethernet": "󰈀",
      "disconnected": "󰤭"
    },
    "tooltip-format": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "noctalia msg panel-toggle control-center network"
  },

  // omarchy.audio — click opens the noctalia audio tab; scroll via noctalia (OSD)
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "noctalia msg panel-toggle control-center audio",
    "on-scroll-up": "noctalia msg volume-up",
    "on-scroll-down": "noctalia msg volume-down",
    "tooltip-format": "{desc}"
  },

  // omarchy.monitor — brightness control (not a CPU/RAM readout; Omarchy's
  // default bar has no sysmon widgets either)
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "noctalia msg brightness-up",
    "on-scroll-down": "noctalia msg brightness-down"
  },

  // omarchy.power — battery via UPower (built into the waybar package)
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"],
    "states": {
      "warning": 20,
      "critical": 10
    },
    "interval": 60,
    "on-click": "noctalia msg panel-toggle control-center power",
    "tooltip-format": "{capacity}% · {time} remaining · {power}W"
  },

  // omarchy.power — power-profiles-daemon; click cycles profiles
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "power-saver": "󰌪",
      "balanced": "󰾅",
      "performance": "󰓅"
    }
  },

  // omarchy power panel-equivalent — noctalia session panel
  "custom/power": {
    "format": "󰐥",
    "on-click": "noctalia msg panel-toggle session",
    "tooltip": false
  },

  // omarchy.media (opt-in) — MPRIS now-playing; playerctl is a waybar dep
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "tooltip-format": "{dynamic}",
    "tooltip-format-paused": "Paused: {dynamic}",
    "player-icons": {
      "default": "󰏥",
      "firefox": "󰈹",
      "mpv": "󰦖",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰐊"
    },
    "dynamic-order": ["title", "artist"],
    "on-click": "noctalia msg panel-toggle control-center media",
    "on-scroll-up": "noctalia msg media next",
    "on-scroll-down": "noctalia msg media previous",
    "interval": 5,
    "tooltip": true
  }
}