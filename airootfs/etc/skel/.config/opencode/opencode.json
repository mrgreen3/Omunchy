{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "pacman -Q": "allow",
      "rm -rf *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "wipefs*": "deny",
      "parted*": "deny",
      "sudo pacman -R*": "ask",
      "sudo pacman -Sy*": "deny",
      "sudo pacman -Syu*": "ask",
      "sudo pacman -Syyu*": "ask",
      "sudo -A pacman -R*": "ask",
      "sudo -A pacman -Sy*": "deny",
      "sudo -A pacman -Syu*": "ask",
      "sudo -A pacman -Syyu*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -R*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -Sy*": "deny",
      "SUDO_ASKPASS=* sudo -A pacman -Syu*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -Syyu*": "ask"
    }
  }
}
