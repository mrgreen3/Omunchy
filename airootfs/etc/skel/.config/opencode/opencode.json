{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "pacman -Q*": "allow",
      "pacman -Si *": "allow",
      "pacman -Ss *": "allow",
      "systemctl status*": "allow",
      "systemctl is-*": "allow",
      "systemctl --user status*": "allow",
      "systemctl list-units*": "allow",
      "journalctl *": "allow",
      "lsblk*": "allow",
      "lspci*": "allow",
      "lsusb*": "allow",
      "ip addr*": "allow",
      "ip link*": "allow",
      "ip route*": "allow",
      "free*": "allow",
      "df *": "allow",
      "uname*": "allow",
      "mmsg get *": "allow",
      "mmsg dispatch reload_config": "allow",
      "omunchy-agents": "allow",
      "omunchy-extras": "allow",
      "omunchy-pkg-present *": "allow",
      "omunchy-pkg-missing *": "allow",
      "omunchy-update-available": "allow",
      "rm -rf *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "wipefs*": "deny",
      "parted*": "deny",
      "sudo pacman -R*": "ask",
      "sudo pacman -Sy*": "deny",
      "sudo pacman -Syu*": "ask",
      "sudo pacman -Syyu*": "ask",
      "sudo -A pacman -R*": "ask",
      "sudo -A pacman -Sy*": "deny",
      "sudo -A pacman -Syu*": "ask",
      "sudo -A pacman -Syyu*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -R*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -Sy*": "deny",
      "SUDO_ASKPASS=* sudo -A pacman -Syu*": "ask",
      "SUDO_ASKPASS=* sudo -A pacman -Syyu*": "ask",
      "omunchy-netcheck": "allow",
      "omunchy-netcheck *": "allow",
      "~/.local/share/omunchy/bin/omunchy-netcheck": "allow",
      "~/.local/share/omunchy/bin/omunchy-netcheck *": "allow",
      "$HOME/.local/share/omunchy/bin/omunchy-netcheck": "allow",
      "$HOME/.local/share/omunchy/bin/omunchy-netcheck *": "allow"
    }
  }
}
