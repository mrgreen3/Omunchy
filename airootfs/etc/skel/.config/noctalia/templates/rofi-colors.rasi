* {
    bg:          #{{ colors.background.default.hex_stripped }}ff;
    bg-menu:     #{{ colors.background.default.hex_stripped }}e6;
    bg-alt:      #{{ colors.surface_container.default.hex_stripped }}ff;
    fg:          #{{ colors.on_surface.default.hex_stripped }}ff;
    fg-dim:      #{{ colors.on_surface_variant.default.hex_stripped }}ff;
    accent:      #{{ colors.primary.default.hex_stripped }}ff;
    urgent:      #{{ colors.error.default.hex_stripped }}ff;
    selected-fg: #{{ colors.on_primary.default.hex_stripped }}ff;
}
