#!/usr/bin/env bash
# obinstall: Omunchy installer. Copies the running live system to disk (no pacstrap, no network).
# Usage: install [--config FILE] [--dry-run] [--yes] [--only PHASE]
set -Eeuo pipefail
INSTALLER_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CONFIG='' ; ONLY='' ; ASSUME_YES=0 ; DRY_RUN=0
ORIG_ARGS=("$@")
while (($#)); do
  case $1 in
    --config) CONFIG=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --only) ONLY=$2; shift 2 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
export DRY_RUN

# the live user has passwordless sudo: re-run as root instead of failing
if ((!DRY_RUN && EUID != 0)); then exec sudo -E "$0" "${ORIG_ARGS[@]}"; fi

if ((DRY_RUN)); then LOG_FILE=${LOG_FILE:-/tmp/obinstall-dryrun.log}; STATE_DIR=/tmp/obinstall-dryrun; fi
. "$INSTALLER_DIR/lib/common.sh"
. "$INSTALLER_DIR/lib/phases.sh"
mkdir -p "$(dirname "$LOG_FILE")"; : >>"$LOG_FILE"

CONF_DIR=$STATE_DIR
if [[ -z $CONFIG ]]; then
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR"
  "$INSTALLER_DIR/wizard" "$CONF_DIR/install.conf"
  CONFIG=$CONF_DIR/install.conf
fi
# shellcheck disable=SC1090
. "$CONFIG"
for v in DISK ENCRYPT USERNAME USER_HASH HOSTNAME TIMEZONE KEYMAP LOCALE; do
  [[ -n ${!v:-} ]] || die "config missing $v"
done
[[ $ENCRYPT == 0 || -s ${LUKS_PASS_FILE:-} ]] || die "encryption on but LUKS_PASS_FILE empty"
# reject bad names now, before anything touches the disk
msg=$(validate_username "$USERNAME") || die "username: $msg"
msg=$(validate_hostname "$HOSTNAME") || die "hostname: $msg"

show_summary
if ((!ASSUME_YES && !DRY_RUN)); then
  gum confirm --default=no "Erase $DISK and install Omunchy?" || die "aborted"
fi
screen "Installing Omunchy"

cleanup() {
  local rc=$?
  # shred wizard-generated secrets; leave user-supplied --config files alone but say so
  local f
  for f in "${LUKS_PASS_FILE:-}" "$CONFIG"; do
    [[ -n $f && -e $f ]] || continue
    if [[ $f == "$STATE_DIR"/* ]]; then shred -u "$f" 2>/dev/null || true
    else warn "left in place (contains secrets, shred it when done): $f"; fi
  done
  ((rc)) && warn "install failed (exit $rc) — see $LOG_FILE"
  # keep the installer window open until acknowledged
  if [[ -t 0 ]]; then echo; read -rsn1 -p "Press any key to exit..." || true; echo; fi
  return $rc
}
trap cleanup EXIT

phases=("${PHASES[@]}")
# --only still runs preflight: it is the check that refuses to wipe the live media
if [[ -n $ONLY ]]; then phases=(preflight); [[ $ONLY == preflight ]] || phases+=("$ONLY"); fi
state_init "${#phases[@]}"
i=0
for p in "${phases[@]}"; do
  declare -F "phase_$p" >/dev/null || die "unknown phase: $p"
  state_update ".current_index=$i | .current_phase=\"$p\""
  t0=$SECONDS
  "phase_$p"
  state_update ".phases += [{name: \"$p\", status: \"ok\", elapsed: $((SECONDS - t0))}]"
  ((++i))
done
state_update '.current_phase="Installation complete" | .finished_at=now'
