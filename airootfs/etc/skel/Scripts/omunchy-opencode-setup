#!/bin/bash

# omunchy:summary=Open the OpenCode AI setup assistant
# omunchy:args=
# omunchy:examples=omunchy opencode setup

# OpenCode is cloud-only (needs a network) but ships free models, so no login
# is required. --standalone keeps it from leaving a background service running
# on the live ISO.

# Needs a terminal; open one if started from a keybind/notification.
[[ -t 0 ]] || exec foot -e "$0" "$@"

have_net() {
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 \
    || curl -fsS --max-time 6 -o /dev/null https://archlinux.org 2>/dev/null
}

pause() { printf '\nPress Enter to close… '; read -r _; }

if ! have_net; then
  notify-send -u critical -a Omunchy "No network connection" \
    "OpenCode needs a connection. Click the network icon in the bar or run nmtui." 2>/dev/null
  printf '\n  No network connection.\n  Connect (click the bar network icon, or run nmtui), then try again.\n'
  pause
  exit 1
fi

exec opencode --standalone --prompt "Use the setup-menu skill to show me what you can set up."
