#!/bin/bash

# omunchy:summary=Generate .desktop entries for every app defined in config/webapps.conf and config/tuis.conf
# omunchy:args=[conf-dir]
# omunchy:examples=omunchy sync

set -euo pipefail

BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Repo checkout: config/ sits next to bin/. Installed (~/Scripts on the
# ISO): there is no such dir, so fall back to the per-user copy from skel.
DEFAULT_CONF_DIR="$(cd -- "$BIN_DIR/.." && pwd)/config"
[[ -d $DEFAULT_CONF_DIR ]] || DEFAULT_CONF_DIR="$HOME/.config/omunchy"
CONF_DIR=${1:-$DEFAULT_CONF_DIR}

WEBAPPS_CONF="$CONF_DIR/webapps.conf"
TUIS_CONF="$CONF_DIR/tuis.conf"

ok=0
fail=0

# Desktop entries reference omunchy-launch-webapp by name, so the scripts must
# be on PATH (emulates how Omarchy installs its bin/ onto PATH).
link_bin() {
    local dest="$HOME/.local/bin"
    mkdir -p "$dest"
    local script name
    for script in "$BIN_DIR"/omunchy-*; do
        name=${script##*/}
        ln -sfn "$script" "$dest/$name"
    done
    ln -sfn "$BIN_DIR/omunchy" "$dest/omunchy"
    echo "[omunchy] Linked scripts into $dest"
}

sync_webapps() {
    [[ -f $WEBAPPS_CONF ]] || {
        echo "[omunchy] No webapps.conf at $WEBAPPS_CONF, skipping"
        return 0
    }
    echo "[omunchy] Syncing web apps from $WEBAPPS_CONF"
    while IFS='|' read -r name url icon || [[ -n $name ]]; do
        name=${name//$'\r'/}
        [[ -z ${name//[[:space:]]/} || $name == \#* ]] && continue
        if "$BIN_DIR/omunchy-webapp-install" "$name" "$url" "$icon"; then
            ok=$((ok + 1))
        else
            echo "[omunchy] FAILED: webapp '$name'" >&2
            fail=$((fail + 1))
        fi
    done <"$WEBAPPS_CONF"
}

sync_tuis() {
    [[ -f $TUIS_CONF ]] || {
        echo "[omunchy] No tuis.conf at $TUIS_CONF, skipping"
        return 0
    }
    echo "[omunchy] Syncing TUIs from $TUIS_CONF"
    while IFS='|' read -r name cmd style icon || [[ -n $name ]]; do
        name=${name//$'\r'/}
        [[ -z ${name//[[:space:]]/} || $name == \#* ]] && continue
        # Legacy 3-field lines (Name|Command|Icon) land the icon in $style.
        if [[ $style != float && $style != tile ]]; then
            icon=$style
            style=float
        fi
        if "$BIN_DIR/omunchy-tui-install" "$name" "$cmd" "${style:-float}" "$icon"; then
            ok=$((ok + 1))
        else
            echo "[omunchy] FAILED: tui '$name'" >&2
            fail=$((fail + 1))
        fi
    done <"$TUIS_CONF"
}

# Earlier versions generated "Add Web App" / "Add TUI" launcher entries that
# cluttered the app menu; remove any left over. Use `omunchy webapp install` /
# `omunchy tui install` from a terminal to add new ones.
remove_old_menu_entries() {
    rm -f "$HOME/.local/share/applications/omunchy-add-webapp.desktop" \
        "$HOME/.local/share/applications/omunchy-add-tui.desktop"
}

link_bin
remove_old_menu_entries
sync_webapps
sync_tuis

echo "[omunchy] Sync complete: $ok created, $fail failed."