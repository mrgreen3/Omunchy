#!/bin/bash

# omunchy:summary=Toggle a bar indicator mode (DnD, night light, stay awake)
# omunchy:args=[toggle-dnd|toggle-night|toggle-awake]
# omunchy:examples=omunchy indicators-toggle toggle-night

# Thin wrapper so the waybar custom module can toggle through the omunchy
# CLI (auto-discovered from bin/omunchy-*), like every other desktop verb.

set -euo pipefail

exec ~/Scripts/indicators.sh "${1:-toggle}"