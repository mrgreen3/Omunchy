#!/bin/bash

# omunchy:summary=Install the pi coding agent (pi.dev) via the official installer
# omunchy:args=[]
# omunchy:examples=omunchy pi install

# One-shot installer for the pi coding agent (https://pi.dev). Runs the official
# `curl -fsSL https://pi.dev/install.sh | sh` in this terminal; the upstream
# script reads its prompts from /dev/tty (so piping works) and bootstraps
# node/npm itself if missing. The shipped "Install Pi" desktop entry removes
# itself on success.

set -euo pipefail

DESKTOP_FILE="$HOME/.local/share/applications/omunchy-pi-install.desktop"

# Find pi even when the launcher's PATH skips the npm user prefix (rofi/foot
# sessions don't always source ~/.profile).
find_pi() {
    command -v pi 2>/dev/null && return 0
    local candidate
    for candidate in "$HOME/.pi/agent/bin/pi" "$HOME/.npm-global/bin/pi" \
                     /usr/local/bin/pi /usr/bin/pi; do
        [[ -x $candidate ]] && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

wait_key() {
    echo
    read -r -n 1 -s -p "Press any key to close... " || true
    echo
}

echo "Checking network..."
if ! curl -fsSL --connect-timeout 5 https://pi.dev >/dev/null 2>&1; then
    echo "No network connection. Connect first and retry."
    wait_key
    exit 1
fi

if PI_BIN=$(find_pi); then
    echo "pi already installed: $("$PI_BIN" --version 2>/dev/null || echo 'unknown version')"
    echo "Nothing to do. Removing the one-shot launcher entry."
    rm -f "$DESKTOP_FILE"
    wait_key
    exit 0
fi

echo "Running the official pi installer (https://pi.dev/install.sh)..."
echo
if curl -fsSL https://pi.dev/install.sh | sh; then
    echo
    if PI_BIN=$(find_pi); then
        echo "pi installed: $("$PI_BIN" --version)"
    else
        echo "Install finished, but 'pi' is not on PATH in this shell yet."
        echo "Open a new terminal and run: pi --version"
    fi
    rm -f "$DESKTOP_FILE"
    echo "Removed the 'Install Pi' launcher entry."
else
    echo
    echo "Install failed (see output above). The launcher entry was kept."
    wait_key
    exit 1
fi

wait_key