#!/usr/bin/env bash
# Install yay AUR helper from source

set -e

echo "Checking network..."
if ! "$HOME/Scripts/netcheck"; then
    echo "Connect first and retry."
    exit 1
fi

if command -v yay >/dev/null 2>&1; then
    echo "yay already installed: $(yay --version)"
    exit 0
fi

# pull in dependencies for build
sudo pacman -Sy --noconfirm --needed base-devel git

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

echo "Cloning yay..."
git clone https://aur.archlinux.org/yay.git "$TMP/yay"

echo "Building and installing yay..."
cd "$TMP/yay"
makepkg -si --noconfirm

echo "yay installed: $(yay --version)"

echo "Removing go package..."
sudo pacman -Rns --noconfirm go 2>/dev/null || true
