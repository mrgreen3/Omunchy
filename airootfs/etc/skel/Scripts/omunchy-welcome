#!/usr/bin/env bash

# omunchy:summary=Live-session login: keybinds hint, warns and watches if offline
# omunchy:args=
# omunchy:examples=omunchy welcome

# Started from mango (config.conf) on the live ISO only. AUTORUN=1 opens the
# OpenCode setup assistant as soon as a connection is up.

set -uo pipefail

AUTORUN="${AUTORUN:-0}"

[[ -d /run/archiso/airootfs ]] || exit 0

# One instance only (a new mango session re-runs autostart).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omunchy-welcome.lock"
flock -n 9 || exit 0

notify() { notify-send -a Omunchy "$@" 2>/dev/null || true; }

have_net() {
  "$HOME/Scripts/netcheck" -q \
    || ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 \
    || ping -c1 -W2 8.8.8.8 >/dev/null 2>&1
}

# Connection up: AUTORUN=1 opens the assistant (warn-only, no toast).
online() {
  [[ $AUTORUN == 1 ]] && setsid -f foot -e opencode --standalone --prompt "Use the omunchy-guide skill to show me what you can set up." >/dev/null 2>&1
}

# Wait for mako to claim the notification bus.
for _ in $(seq 30); do
  busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && break
  sleep 1
done

# Keybinds hint: once per login, whatever the network state.
notify -t 15000 "Keybinds" "Press Super+K to see all keybinds."

# Give NetworkManager a moment before calling it offline.
for _ in $(seq 10); do have_net && break; sleep 2; done

if have_net; then
  online
  exit 0
fi

# Persistent (-t 0) until dismissed; -p prints its id for the watcher to close.
warn_id=$(notify -p -u critical -t 0 "No network connection" \
"Wi-Fi: click the network icon in the bar, or run nmtui.
Wired: plug in a cable.
Software installs and the AI assistant need a connection.")

# Watch for a connection for 30 minutes.
while (( SECONDS < 1800 )); do
  sleep 5
  if have_net; then
    [[ -n $warn_id ]] && makoctl dismiss -n "$warn_id" 2>/dev/null
    online
    exit 0
  fi
done
