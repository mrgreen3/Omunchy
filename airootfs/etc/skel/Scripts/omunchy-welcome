#!/bin/bash

# omunchy:summary=Live-session network check, notifies if online or warns and watches if offline
# omunchy:args=
# omunchy:examples=omunchy welcome

# Started from sway (looknfeel) on the live ISO only. AUTORUN=1 opens the
# OpenCode setup assistant as soon as a connection is up.

set -uo pipefail

AUTORUN="${AUTORUN:-0}"

[[ -d /run/archiso/airootfs ]] || exit 0

# One instance only (a new sway session re-runs autostart).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omunchy-welcome.lock"
flock -n 9 || exit 0

notify() { notify-send -a Omunchy "$@" 2>/dev/null || true; }

have_net() {
  ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 \
    || ping -c1 -W2 8.8.8.8 >/dev/null 2>&1 \
    || curl -fsS --max-time 6 -o /dev/null https://archlinux.org 2>/dev/null
}

# Active connection as "name (type)".
active_conn() {
  nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
    | grep -v -E '^(lo|docker|virbr)' | head -1 | sed 's/^\(.*\):\(.*\)$/\1 (\2)/'
}

online() {
  notify -u normal "Network connected" "$(active_conn)
Super+A opens the AI setup assistant."
  [[ $AUTORUN == 1 ]] && setsid -f "$HOME/Scripts/omunchy-opencode-setup" >/dev/null 2>&1
}

# Wait for mako to claim the notification bus.
for _ in $(seq 30); do
  busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && break
  sleep 1
done

# Give NetworkManager a moment before calling it offline.
for _ in $(seq 10); do have_net && break; sleep 2; done

if have_net; then
  online
  exit 0
fi

notify -u critical "No network connection" \
"Wi-Fi: click the network icon in the bar, or run nmtui.
Wired: plug in a cable.
Software installs and the AI assistant need a connection."

# Watch for a connection for 30 minutes.
while (( SECONDS < 1800 )); do
  sleep 5
  if have_net; then
    online
    exit 0
  fi
done

notify -u normal "Still no network" \
"Stopped watching for a connection. Connect, then press Super+A for the AI setup assistant."
