#!/bin/bash
# Install opencode (the open source coding agent) from the official Arch
# extra repository:
#   sudo pacman -S --needed opencode
# Signed package installed to /usr/bin — no piping a remote script to bash
# and no ~/.opencode/bin PATH special-casing. Kept on demand (deliberately
# not in packages.x86_64; the package is ~194 MiB installed).

set -e

ENTRY="$HOME/.local/share/applications/omunchy-tui-install-opencode.desktop"

if command -v opencode >/dev/null 2>&1; then
    echo "opencode already installed: $(opencode --version 2>/dev/null)"
    rm -f "$ENTRY" && echo "Removed the 'Install OpenCode' launcher entry."
    read -n 1 -s -r -p "Press any key to close..."
    echo
    exit 0
fi

echo "Checking network..."
if ! curl -s --connect-timeout 5 https://archlinux.org >/dev/null 2>&1; then
    echo "No network connection. Connect first and retry."
    read -n 1 -s -r -p "Press any key to close..."
    echo
    exit 1
fi

echo "Installing opencode from the official repos (sudo pacman -Sy --needed opencode)..."
if sudo pacman -Sy --needed opencode; then
    echo "opencode installed: $(opencode --version)"
    echo "Installed to /usr/bin/opencode — on PATH in every shell, nothing to add to your shell rc files."
    echo "Next step: run 'opencode auth login' to add your API key."
    rm -f "$ENTRY" && echo "Removed the 'Install OpenCode' launcher entry."
else
    echo "pacman could not install opencode. Try again later or install it manually:"
    echo "    sudo pacman -Sy opencode"
fi

read -n 1 -s -r -p "Press any key to close..."
echo