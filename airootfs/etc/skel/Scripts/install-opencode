#!/bin/bash
# Install opencode (the open source coding agent) via the official installer:
#   curl -fsSL https://opencode.ai/install | bash
# The installer is non-interactive, needs no node/npm, and installs one binary
# to ~/.opencode/bin, adding it to PATH in your shell rc files.

set -e

ENTRY="$HOME/.local/share/applications/omunchy-tui-install-opencode.desktop"
OC_BIN="$HOME/.opencode/bin/opencode"

if command -v opencode >/dev/null 2>&1 || [ -x "$OC_BIN" ]; then
    echo "opencode already installed: $(opencode --version 2>/dev/null || "$OC_BIN" --version)"
    rm -f "$ENTRY" && echo "Removed the 'Install OpenCode' launcher entry."
    read -n 1 -s -r -p "Press any key to close..."
    echo
    exit 0
fi

echo "Checking network..."
if ! curl -s --connect-timeout 5 https://opencode.ai >/dev/null 2>&1; then
    echo "No network connection. Connect first and retry."
    read -n 1 -s -r -p "Press any key to close..."
    echo
    exit 1
fi

echo "Running the official opencode installer..."
if curl -fsSL https://opencode.ai/install | bash; then
    if [ -x "$OC_BIN" ]; then
        echo "opencode installed: $("$OC_BIN" --version)"
        echo "It lives in ~/.opencode/bin; new terminals find it automatically."
        echo "Next step: run 'opencode auth login' to add your API key."
        rm -f "$ENTRY" && echo "Removed the 'Install OpenCode' launcher entry."
    else
        echo "Installer finished, but $OC_BIN was not found."
        echo "Check ~/.opencode/bin and your shell PATH."
    fi
else
    echo "The opencode installer failed. Try again later or run it manually:"
    echo "    curl -fsSL https://opencode.ai/install | bash"
fi

read -n 1 -s -r -p "Press any key to close..."
echo