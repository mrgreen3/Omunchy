#!/usr/bin/env bash
# Install the OpenCode AI assistant (official repos) if missing, then start it.
#   install-opencode             install if needed, then open OpenCode
#   install-opencode --guide     same, opening with the omunchy-guide skill
#   install-opencode --no-start  install only

set -e

start=1 guide=0
case "${1:-}" in
    "") ;;
    --guide) guide=1 ;;
    --no-start) start=0 ;;
    -h | --help) sed -n '2,5p' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (use --guide, --no-start or no option)" >&2; exit 2 ;;
esac

# Started from the launcher the foot window would close on an error before it can be read.
fail() {
    echo "$1" >&2
    [[ -t 0 ]] && read -rp "Press Enter to close." _
    exit 1
}

if ! command -v opencode >/dev/null 2>&1; then
    echo "Checking network..."
    "$HOME/Scripts/netcheck" || fail "OpenCode needs a network connection. Connect first and retry."

    SUDO=(sudo) confirm=()
    if [[ ! -t 0 ]]; then
        [[ -n ${SUDO_ASKPASS:-} ]] && SUDO=(sudo -A)
        confirm=(--noconfirm)
    fi
    # the ISO ships no sync databases, so a plain -S cannot work: full update (-Syu).
    # live: keep the running kernel, or its modules vanish until a reboot that loses everything
    ignore=()
    [[ -d /run/archiso/airootfs ]] && ignore=(--ignore linux)

    echo "Installing OpenCode (about 80 MiB download, 200 MiB installed) with a full system update."
    [[ -d /run/archiso/airootfs ]] && echo "Live session: this runs from RAM and is lost on reboot."
    "${SUDO[@]}" pacman -Syu --needed "${confirm[@]}" "${ignore[@]}" opencode ||
        fail "Install failed. On signature errors run fix-keys, then retry."
    guide=1
fi

((start)) || exit 0
if ((guide)); then
    exec opencode --standalone --prompt "Use the omunchy-guide skill to show me what you can set up."
fi
exec opencode --standalone
