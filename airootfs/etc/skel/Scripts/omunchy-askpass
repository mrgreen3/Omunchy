#!/bin/sh
# omunchy-askpass: password prompt for `sudo -A` (sudo runs it via SUDO_ASKPASS).
# Shows a themed rofi password box that also names the command sudo is about to
# run, read from sudo's own command line. The password goes straight to sudo.
# Only sudo may call this: run by anything else (e.g. an assistant's shell) it
# refuses, so the password cannot be captured as command output.
case $(ps -o comm= -p "$PPID" 2>/dev/null) in
  sudo | sudo-rs) ;;
  *) echo "omunchy-askpass: only sudo may call this" >&2; exit 1 ;;
esac

max=240
cmd=$(tr '\0' ' ' <"/proc/$PPID/cmdline" 2>/dev/null | tr '\n' ';' | tr -d '\001-\010\013-\037\177' | sed 's/ *$//')
if [ -z "$cmd" ]; then
  cmd="(could not read the command: cancel unless you expect this)"
elif [ "${#cmd}" -gt "$max" ]; then
  extra=$((${#cmd} - max))
  cmd="$(printf '%s' "$cmd" | cut -c1-"$max")  ... (+$extra more characters: cancel and ask for a shorter command)"
fi
cmd=$(printf '%s' "$cmd" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

exec rofi -dmenu -password -p "${1:-Password: }" -mesg "Run as root:  <b>$cmd</b>" \
  -theme-str 'window { width: 40em; } mainbox { children: [ message, inputbar ]; } listview { enabled: false; } entry { placeholder: ""; }' </dev/null
