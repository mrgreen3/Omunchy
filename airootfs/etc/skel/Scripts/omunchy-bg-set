#!/bin/bash

# omunchy:summary=Set the desktop wallpaper image and recolour the desktop from it
# omunchy:args=[--no-theme] <image-path>
# omunchy:examples=omunchy bg set ~/Backgrounds/mountain-moon.jpg

set -euo pipefail

usage() {
    printf 'Usage: omunchy bg set [--no-theme] <image-path>\n'
    printf 'Rewrites the swaybg exec line in ~/.config/sway/looknfeel and applies it\n'
    printf 'to the running session, then recolours the desktop from the image\n'
    printf '(omunchy theme wallpaper). --no-theme keeps the current colours.\n'
}

NO_THEME=0
IMG=""
for arg in "$@"; do
    case $arg in
        -h | --help) usage; exit 0 ;;
        --no-theme) NO_THEME=1 ;;
        *) [[ -z $IMG ]] || { usage; exit 1; }; IMG=$arg ;;
    esac
done
[[ -n $IMG ]] || { usage; exit 1; }

[[ -f $IMG ]] || {
    echo "Not a file: $IMG" >&2
    exit 1
}
IMG=$(readlink -f -- "$IMG")

SWAY_CONF="$HOME/.config/sway/looknfeel"
[[ -f $SWAY_CONF ]] || {
    echo "No $SWAY_CONF — install the Omunchy configs first." >&2
    exit 1
}

# Copy into ~/Backgrounds so the wallpaper survives the source file moving
# (matches how the ISO ships Backgrounds/). A same-named but different file
# must not silently win: give the copy a unique name instead.
BG_DIR="$HOME/Backgrounds"
mkdir -p "$BG_DIR"
DEST="$BG_DIR/$(basename -- "$IMG")"
if [[ -e $DEST ]] && ! cmp -s -- "$IMG" "$DEST"; then
    base=${DEST%.*}
    ext=""
    [[ $base != "$DEST" ]] && ext=".${DEST##*.}"
    n=1
    while [[ -e "$base-$n$ext" ]]; do
        n=$((n + 1))
    done
    DEST="$base-$n$ext"
fi
cp -n -- "$IMG" "$DEST" 2>/dev/null || true
INSTALLED=$DEST
[[ -f $INSTALLED ]] || INSTALLED=$IMG

# Replace ONLY the WALLPAPER_MARKER exec line (swaybg has no preload/unload —
# each invocation is a full background set; the sleep guards sway's startup).
# The path is escaped for the single-quoted sway exec line (' -> '\'') and for
# the sed replacement (\, &, and the | delimiter), so an odd filename cannot
# corrupt looknfeel.
# Escape the path for the single-quoted sway exec line (' -> '\''). The
# sed-replacement escaping (\, &, |) happens on the whole line right
# before it is interpolated into the s||| command below.
sed_escape() {
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
}
SWAY_LINE="exec sleep 1 && swaybg -i '$(sed_escape "$INSTALLED")' -m fill  # WALLPAPER_MARKER"
sed -i \
    -e "s|^exec sleep 1 && swaybg.*WALLPAPER_MARKER.*|$(printf '%s' "$SWAY_LINE" | sed 's/[\\&|]/\\&/g')|" \
    -e "s|^exec .*swaybg.*WALLPAPER_MARKER.*|$(printf '%s' "$SWAY_LINE" | sed 's/[\\&|]/\\&/g')|" \
    "$SWAY_CONF"

# Apply to the running session right away (kills the old swaybg first so the
# new one owns the background; swaybg draws all outputs by default). Spawned
# directly, not via `swaymsg exec`: swaymsg does not quote its arguments, so
# sway parses the `;` in a compound command as its own command separator.
if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v swaybg >/dev/null 2>&1; then
    setsid -f sh -c 'pkill -x swaybg 2>/dev/null; sleep 1; exec swaybg -i "$1" -m fill' _ "$INSTALLED" </dev/null >/dev/null 2>&1
fi

echo "Wallpaper set: $INSTALLED"

# Recolour from the image; skipped with --no-theme, or when matugen is missing.
if ((NO_THEME == 0)); then
    BIN_DIR=$(cd -P "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
    if command -v matugen >/dev/null 2>&1; then
        "$BIN_DIR/omunchy-theme-wallpaper" "$INSTALLED" || echo "Theme generation failed; colours unchanged." >&2
    else
        echo "matugen not installed; wallpaper set, colours unchanged."
    fi
fi