# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Depends = pacman-mirrorlist
Description = Uncommenting mirrorlist for the live ISO...
When = PostTransaction
Exec = /bin/sh -c 'sed -E -i "s/^#(Server = https:)/\\1/" /etc/pacman.d/mirrorlist'
