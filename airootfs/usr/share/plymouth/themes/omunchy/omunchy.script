Window.SetBackgroundTopColor(0.110, 0.086, 0.075);
Window.SetBackgroundBottomColor(0.039, 0.031, 0.027);

W = Window.GetWidth();
H = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(Window.GetX() + (W - logo.image.GetWidth()) / 2, Window.GetY() + H * 0.38 - logo.image.GetHeight() / 2, 10);

entry.image = Image("entry.png");
entry.sprite = Sprite();
entry.x = Window.GetX() + (W - entry.image.GetWidth()) / 2;
entry.y = Window.GetY() + H * 0.58;
entry.sprite.SetPosition(entry.x, entry.y, 10);

lock.image = Image("lock.png");
lock.sprite = Sprite();
lock.sprite.SetPosition(entry.x + 18, entry.y + (entry.image.GetHeight() - lock.image.GetHeight()) / 2, 11);

bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
bullets = [];
nbullets = 0;

fun hide_password() {
    entry.sprite.SetOpacity(0);
    lock.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; i < nbullets; i++)
        bullets[i].SetOpacity(0);
}

fun display_password(text, count) {
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetOpacity(1);
    lock.sprite.SetImage(lock.image);
    lock.sprite.SetOpacity(1);

    text = "Enter disk password";
    prompt.image = Image.Text(text, 0.604, 0.576, 0.549, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(Window.GetX() + (W - prompt.image.GetWidth()) / 2, entry.y - prompt.image.GetHeight() - 14, 11);
    prompt.sprite.SetOpacity(1);

    max = Math.Int((entry.image.GetWidth() - 80) / 20);
    shown = count;
    if (shown > max) shown = max;
    for (i = 0; i < shown; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(entry.x + 56 + i * 20, entry.y + (entry.image.GetHeight() - bullet.image.GetHeight()) / 2, 12);
        bullets[i].SetOpacity(1);
    }
    for (i = shown; i < nbullets; i++)
        bullets[i].SetOpacity(0);
    if (shown > nbullets) nbullets = shown;
}

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(hide_password);

msg.sprite = Sprite();
fun display_message(text) {
    msg.image = Image.Text(text, 0.604, 0.576, 0.549, 1, "Sans 11");
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(Window.GetX() + (W - msg.image.GetWidth()) / 2, Window.GetY() + H * 0.85, 10);
}
Plymouth.SetMessageFunction(display_message);
